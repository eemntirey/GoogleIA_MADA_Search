<Window x:Class="MadaSearch.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="MadaSearch — MadagascarBrowser" Height="720" Width="1200"
        Background="{StaticResource BrushPrimaryDark}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Ligne 0: Barre d'onglets et titre -->
            <RowDefinition Height="42" />
            <!-- Ligne 1: Barre de navigation et Omnibox -->
            <RowDefinition Height="48" />
            <!-- Ligne 2: Zone Web / Contenu Principal -->
            <RowDefinition Height="*" />
            <!-- Ligne 3: Barre de statut & DataSaver -->
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Barre d'onglets -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Logo & Brand -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,16,0">
                    <TextBlock Text="🇲🇬" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="MadaSearch" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Bouton Nouvel Onglet -->
                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource NavButtonStyle}"
                        Width="32" Height="32" Margin="4,0,8,0" Click="OnNewTabClick"
                        ToolTip="Ouvrir un nouvel onglet (Ctrl+T)" />

                <!-- Liste des onglets -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurfaceVariant}" Margin="2,4,2,0"
                                        CornerRadius="6,6,0,0" Padding="10,6" Width="180">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="✕" Background="Transparent"
                                                Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0"
                                                Padding="4,0" Cursor="Hand" Click="OnCloseTabClick" Tag="{Binding Id}" />
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Barre de navigation -->
        <Border Grid.Row="1" Background="{StaticResource BrushSurfaceVariant}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="True">
                <!-- Boutons Navigation -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,8,0">
                    <Button Content="◀" Style="{StaticResource NavButtonStyle}" Width="32" Height="32" Click="OnBackClick" ToolTip="Page précédente (Alt+Gauche)" />
                    <Button Content="▶" Style="{StaticResource NavButtonStyle}" Width="32" Height="32" Click="OnForwardClick" ToolTip="Page suivante (Alt+Droite)" />
                    <Button Content="⟳" Style="{StaticResource NavButtonStyle}" Width="32" Height="32" Click="OnRefreshClick" ToolTip="Actualiser (Ctrl+R)" />
                    <Button Content="🏠" Style="{StaticResource NavButtonStyle}" Width="32" Height="32" Click="OnHomeClick" ToolTip="Page d'accueil MadaSearch" />
                </StackPanel>

                <!-- Actions Droite -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <!-- Badge DataSaver -->
                    <Border Background="#0C344E" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1"
                            CornerRadius="14" Padding="10,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ DataSaver" Foreground="{StaticResource BrushAccentCyan}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Button Content="⭐" Style="{StaticResource NavButtonStyle}" Width="32" Height="32" Click="OnAddBookmarkClick" ToolTip="Ajouter aux favoris (Ctrl+D)" />
                    <Button Content="✨ IA" Style="{StaticResource NavButtonStyle}" Width="40" Height="32" Click="OnAssistantClick" ToolTip="Assistant intelligent local" />
                </StackPanel>

                <!-- Omnibox (Barre d'adresse & recherche) -->
                <Border Background="{StaticResource BrushPrimaryDark}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="6,2">
                    <DockPanel LastChildFill="True">
                        <!-- Indicateur de sécurité -->
                        <TextBlock Text="🔒" DockPanel.Dock="Left" Margin="6,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="#10B981" />

                        <!-- Champ de saisie -->
                        <TextBox x:Name="UrlTextBox" Text="{Binding CurrentUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="{StaticResource BrushTextPrimary}"
                                 BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"
                                 KeyDown="OnUrlKeyDown" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- WebView2 Web Content Container -->
        <Grid Grid.Row="2">
            <wv2:WebView2 x:Name="BrowserWebView" />

            <!-- Volet Assistant Intelligent -->
            <Border Width="320" HorizontalAlignment="Right" Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsAssistantOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="✨ Assistant MadaSearch" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushAccentCyan}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AssistantMessage}" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Barre de statut inférieure -->
        <Border Grid.Row="3" Background="{StaticResource BrushPrimaryDark}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="12,2">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Mode Madagascar Connectivité Optimisée" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding DataSaverInfo}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
